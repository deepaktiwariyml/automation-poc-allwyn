{
  "name": "allwyn-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright web and API automation suite for Allwyn",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:list": "playwright test --list",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:list",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:web": "PROJECT=chromium playwright test",
    "test:web:all-browsers": "PROJECT=all-browsers playwright test",
    "test:web:mobile": "PROJECT=chromium MOBILE_MODE=true playwright test",
    "test:qa:smoke": "ENV=qa HEADLESS=true playwright test --grep @smoke",
    "test:qa:regression": "ENV=qa HEADLESS=true playwright test --grep @regression",
    "report:generate": "allure generate reports/web/allure-results --clean --output reports/web/allure-report",
    "report:open": "allure open reports/web/allure-report",
    "report:notify": "node scripts/notify-slack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@slack/web-api": "^8.2.0",
    "@types/node": "^22.20.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
