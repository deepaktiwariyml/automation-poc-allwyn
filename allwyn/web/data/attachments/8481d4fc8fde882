{"data":[{"id":365,"documentId":"pg7egs0qzk0f23r574ts5ihh","heading":"Allwyn announcement of issue price for re-investment of €0.80 special distribution","slug":"allwyn-announcement-of-issue-price-for-re-investment-of-0-80-special-distribution","date":"2026-04-24","perex":"Luxembourg, 24 April 2026 – Allwyn AG (the “Company”) today announces the issue price of the new shares to be issued as a result of the re-investment of the special distribution of €0.80 per common share that was approved by the board of directors of the Company on 30 March 2026 (the “Special Distribution”) by the beneficiaries who elect to receive new shares instead of cash, with a corresponding share capital increase under the existing authorised share capital. The period for the exercise of the right of re-investment of the Special Distribution is from Tuesday, 14 April 2026 up to (and including) Monday, 27 April 2026. ","download_label":"Download PDF","createdAt":"2026-04-24T10:13:06.606Z","updatedAt":"2026-04-24T16:33:07.500Z","publishedAt":"2026-04-24T16:33:07.949Z","locale":"en","download_file":{"id":6703,"documentId":"be5a2r5vgmtt4d1j42o8vaq4","name":"Announcement re Special Distribution – Issue Price (260424).pdf","alternativeText":null,"caption":null,"width":null,"height":null,"formats":null,"hash":"Announcement_re_Special_Distribution_Issue_Price_260424_bbb6c6c2fc","ext":".pdf","mime":"application/pdf","size":48.44,"url":"https://cdn.allwyn.com/Announcement_re_Special_Distribution_Issue_Price_260424_bbb6c6c2fc.pdf","previewUrl":null,"provider":"aws-s3","provider_metadata":null,"createdAt":"2026-04-24T16:33:01.758Z","updatedAt":"2026-04-24T16:33:01.758Z","publishedAt":"2026-04-24T16:33:01.758Z","focalPoint":null},"metadata":{"id":6575,"title":"Announcement of the issue price","description":null,"og_title":"Announcement of the issue price","og_description":null,"noindex":false},"localizations":[],"dynamic_zone":[{"id":497,"content":"On 2 April 2026, the Company announced that the issue price of any new shares to be issued in connection with the Special Distribution will be equal to the volume weighted average price (“VWAP”) of the five (5) trading days ending on the trading day immediately preceding the end of the period for the exercise of the right of re-investment of the Special Distribution. \n\nIn accordance with the manner of calculation described above and on the basis of the VWAP of the Company’s common share from Monday, 20 April 2026, to (and including) Friday, 24 April 2026, the issue price of the New Shares is €13.47. ","__component":"modules.rich-text-module"}]}],"meta":{"pagination":{"page":1,"pageSize":1,"pageCount":1,"total":1}}}