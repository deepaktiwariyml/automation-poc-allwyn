":"md"},"items":[{"id":801,"heading":"Dajana Weinhofer","text":"Global Head of Talent Acquistion & Employer Branding","minititle":null,"minititle_url":"https://linkedin.com"},{"id":802,"heading":"Tenni Cole-Etti","text":"Talent Acquisition Partner","minititle":null,"minititle_url":"https://linkedin.com"},{"id":803,"heading":"Nikola Trúchlá","text":"Senior Talent Acquisition Specialist","minititle":null,"minititle_url":null},{"id":804,"heading":"Denisa Legner","text":"Recruitment Coordinator","minititle":null,"minititle_url":null}],"__component":"modules.banner-cards-module"},{"id":431,"items_heading":null,"bg_color":"white","fg_color":"white","two_cols_text":null,"image":{"id":7534,"documentId":"kd2uqufw47fnsm6sg1tqa909","name":"resume-genius-IESB4iFVuzA-unsplash.jpg","alternativeText":null,"caption":null,"width":5472,"height":3648,"formats":{"thumbnail":{"ext":".jpg","url":"https://cdn.allwyn.com/thumbnail_resume_genius_IESB_4i_F_Vuz_A_unsplash_87f25df93d.jpg","hash":"thumbnail_resume_genius_IESB_4i_F_Vuz_A_unsplash_87f25df93d","mime":"image/jpeg","name":"thumbnail_resume-genius-IESB4iFVuzA-unsplash.jpg","path":null,"size":6.53,"width":234,"height":156,"sizeInBytes":6530}},"hash":"resume_genius_IESB_4i_F_Vuz_A_unsplash_87f25df93d","ext":".jpg","mime":"image/jpeg","size":3989.91,"url":"https://cdn.allwyn.com/resume_genius_IESB_4i_F_Vuz_A_unsplash_87f25df93d.jpg","previewUrl":null,"provider":"aws-s3","provider_metadata":null,"createdAt":"2026-06-04T14:43:11.606Z","updatedAt":"2026-06-04T14:43:11.606Z","publishedAt":"2026-06-04T14:43:11.634Z","focalPoint":null},"image_mobile":null,"items":[{"id":799,"heading":"Show us <BR> how you match the role.","text":"You don’t need to tick every single box. Focus on the experiences, skills and motivations that truly connect you to the role and tell your story.","minititle":null,"minititle_url":null},{"id":800,"heading":"The whole process of application","text":"Do you want to know more about how to be ready for our job interview? Just click and read the whole story.","minititle":null,"minititle_url":null}],"title":{"id":5324,"text":null,"align":"center","text_size":null},"__component":"modules.fancy-banner-cards-module"},{"id":200,"title":{"id":5322,"text":null,"align":"center","text_size":null},"items":[{"id":273,"title":"How do I apply?","text":"You can apply directly via our career page by selecting the role you’re interested in and submitting your application.\n\nIf you don’t find a suitable position right now, you’re welcome to send a general application to join our talent pool – that way we can stay in touch about future opportunities."},{"id":274,"title":"How long does the hiring process take?","text":"It depends on the role and availability. Rather than fixed timelines, we focus on transparency. You’ll always know where you are in the process and what’s coming next."},{"id":275,"title":"Who will I be in contact with during the process?","text":"Your recruiter will be your main point of contact throughout the entire hiring process and will be happy to answer any questions along the way."},{"id":276,"title":"How can I prepare for an interview?","text":"Take a look at the job description and think about how your experience matches the role.\n\nSpend some time getting to know us – our business, our culture and what we stand for.\nPrepare a few examples from your experience and some questions you’d like to ask.\n\nAnd most importantly: be yourself. We want to get to know the real you.\n"},{"id":277,"title":"Do I need to bring any documents to the interview?","text":"Usually, no. We already have your CV. If we need any additional documents, we’ll let you know in advance."},{"id":278,"title":"Is there a dress code?","text":"We don’t have a strict dress code. Smart casual is usually a good guide – wear something you feel comfortable and confident in."},{"id":279,"title":"Do you offer remote or hybrid work?","text":"That depends on the role and location. We’ll always clarify what’s possible during the hiring process."},{"id":280,"title":"Will I receive feedback?","text":"We aim to provide feedback whenever possible, especially after interviews. Transparency and respect matter to us."}],"__component":"modules.faq-module"},{"id":695,"elfsight_widget_pid":"elfsight-app-38755dae-8e89-48c8-b0eb-9f23b630f359","bg_color":"teal-blue-700","fg_color":"white","title":{"id":5323,"text":null,"align":"center","text_size":null},"links":[],"__component":"modules.social-widget-module"}]},"meta":{}}