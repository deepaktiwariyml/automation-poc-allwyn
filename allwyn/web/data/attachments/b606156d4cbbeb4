null,"og_image":null},"dynamic_zone":[{"id":1751,"perex":"<BR>\n\nThe lottery and gaming sector is transforming rapidly, driven by technological change, new content formats, and the ever-increasing expectations of players and regulators. In this environment, scale, diversification and operational excellence matter more than ever. As a result of the continued successful execution of our strategy, Allwyn enters 2026 as a strong and agile business, equipped and positioned to lead the next phase of our industry’s evolution.","bg_color":"teal-600","fg_color":"white","variant":"list","two_cols_text":{"id":2479,"heading":"Building a leading global gaming entertainment company","text":"\nIn a landmark transaction for Allwyn and for the global gaming sector, Allwyn agreed a combination with OPAP, its publicly-listed subsidiary operating in Greece and Cyprus. This completed in March 2026, resulting in Allwyn being listed on the Athens stock exchange and creating the second largest listed lottery and gaming operator globally."},"items":[{"id":1653,"name":"Karel Komarek","position":"Chair of the Board","text":"\"2025 was a landmark year, defined by major strategic milestones and operational progress as we advance towards our vision of being the leading global gaming entertainment company.\"","variant":"fill"}],"__component":"modules.testimony-list-module"},{"id":595,"bg_color":"white","fg_color":"dark","title":{"id":4324,"text":null,"align":"left","text_size":null},"items":[{"id":661,"value":4.1,"prefix":"€","suffix":"bn","label":"Net Revenue","display_value":null},{"id":662,"value":4,"prefix":"+","suffix":"%","label":"New Revenue Growth","display_value":null},{"id":663,"value":37,"prefix":null,"suffix":"%","label":"Online NGR share","display_value":null},{"id":664,"value":1.6,"prefix":"€","suffix":"bn","label":"Adjusted EBITDA","display_value":null},{"id":665,"value":39,"prefix":null,"suffix":"%","label":"Adjusted EBITDA margin of Net Revenue","display_value":null}],"__compone